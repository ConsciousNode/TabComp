+
+/* Kehai: doomgeneric's i_video.c keeps the palette in colors[] (gamma applied)
+   and raises palette_changed; copy it into TabComp's palette RAM on the next frame. */
+struct color { uint32_t b:8; uint32_t g:8; uint32_t r:8; uint32_t a:8; };
+extern struct color colors[256];
+extern int palette_changed;
+static void tc_sync_palette(void) {
+  unsigned char *pal = (unsigned char*)TC_PALETTE_ADDR;
+  int i;
+  for (i = 0; i < 256; i++) { pal[i*3] = colors[i].r; pal[i*3+1] = colors[i].g; pal[i*3+2] = colors[i].b; }
+  palette_changed = 0;
 }
 
 void DG_DrawFrame(void) {
+  if (palette_changed) tc_sync_palette();
   if (DG_ScreenBuffer && (unsigned int)DG_ScreenBuffer != TC_VRAM_ADDR) {
     memcpy((void*)TC_VRAM_ADDR, DG_ScreenBuffer, DOOMGENERIC_RESX * DOOMGENERIC_RESY);
   }
@@ -101,3 +111,10 @@
 void DG_PlaySound8(const uint8_t* samples, int len, int sample_rate) {
   __sys(30, samples, len, sample_rate);
 }
